<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Exclude encrypted databases, keystore metadata, and credentials from OS Auto Backup -->
    <exclude domain="database" path="ultron_omega.db" />
    <exclude domain="database" path="ultron_omega.db-wal" />
    <exclude domain="database" path="ultron_omega.db-shm" />
    <exclude domain="database" path="ultron_omega.db-journal" />
    <exclude domain="file" path="datastore/ultron_omega_secure_prefs.preferences_pb" />
    <exclude domain="file" path="ultron_workspace" />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
